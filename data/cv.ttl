# cv.ttl - Michael's personal CV / Portfolio Data

@prefix cv: <http://example.org/cv#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix schema:  <http://schema.org/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ─────────────────────────────────────────────
# Person
# ─────────────────────────────────────────────


cv:me a foaf:Person ;
    foaf:firstName "Michael" ;
    foaf:lastName "Mayr" ;
    foaf:homepage <https://MintMayr.github.io> ;
    cv:hasSkill cv:skill-vue, cv:skill-typescript, cv:skill-java, cv:skill-spring-boot, cv:skill-software-engineering, cv:skill-project-management, cv:skill-angular, cv:skill-python, cv:skill-algorithms ; #TODO: Add further skills
    cv:workedAt cv:exp-siemens ;
    cv:studiedAt cv:edu-tuw-msc, cv:edu-tuw-bsc ;
    cv:hasProject cv:proj-lidarc ;
    cv:speaksLanguage cv:lang-german, cv:lang-english .


# ─────────────────────────────────────────────
# Skills
# ─────────────────────────────────────────────

cv:skill-vue a cv:Skill ;
    skos:prefLabel "Vue.js" ;
    cv:category cv:cat-frontend ;
    cv:proficiency "Advanced" .

cv:skill-typescript a cv:Skill ;
    skos:prefLabel "TypeScript" ;
    cv:category cv:cat-language ;
    cv:proficiency "Advanced" .

cv:skill-java a cv:Skill ;
    skos:prefLabel "Java" ;
    cv:category cv:cat-language ;
    cv:proficiency "Advanced" .

cv:skill-spring-boot a cv:Skill ;
    skos:prefLabel "Spring Boot" ;
    cv:category cv:cat-framework ;
    cv:proficiency "Advanced" .

cv:skill-software-engineering a cv:Skill ;
    skos:prefLabel "Software Engineering" ;
    cv:category cv:cat-engineering ;
    cv:proficiency "Advanced" .

cv:skill-project-management a cv:Skill ;
    skos:prefLabel "Project Management" ;
    cv:proficiency "Simple" .


cv:skill-angular a cv:Skill ;
    skos:prefLabel "Angular" ;
    cv:category cv:cat-framework ;
    cv:proficiency "Advanced" .

cv:skill-python a cv:Skill ;
    skos:prefLabel "Python" ;
    cv:category cv:cat-language ;
    cv:proficiency "Advanced" .

cv:skill-algorithms a cv:Skill ;
    skos:prefLabel "Algorithms" ;
    cv:category cv:cat-engineering ;
    cv:proficiency "Advanced" .

# TODO: Add more

# ─────────────────────────────────────────────
# Skill Categories
# ─────────────────────────────────────────────

cv:cat-frontend a cv:SkillCategory ;
    skos:prefLabel "Frontend" ;
    cv:color "blue" .

cv:cat-language a cv:SkillCategory ;
    skos:prefLabel "Programming Language" ;
    cv:color "violet" .

cv:cat-framework a cv:SkillCategory ;
    skos:prefLabel "Framework" ;
    cv:color "green" .

cv:cat-data a cv:SkillCategory ;
    skos:prefLabel "Data & Semantics" ;
    cv:color "teal" .

cv:cat-devops a cv:SkillCategory ;
    skos:prefLabel "DevOps & Tooling" ;
    cv:color "orange" .

cv:cat-engineering a cv:SkillCategory ;
    skos:prefLabel "Engineering" ;
    cv:color "silver" .

#TODO: Refine and add more


# ─────────────────────────────────────────────
# Experiences
# ─────────────────────────────────────────────

cv:exp-siemens a schema:Organization ;
    skos:prefLabel "Siemens Mobility Austria GmbH" .




# ─────────────────────────────────────────────
# Education
# ─────────────────────────────────────────────


cv:edu-tuw-msc a schema:EducationalOrganization ;
    schema:name "Technical University of Vienna" ;
    cv:degree "M.Sc. Software Engineering" ;
    cv:startDate "2025-10-01"^^xsd:date ;
    cv:status "Ongoing" ;
    cv:usedSkill cv:skill-vue, cv:skill-project-management, cv:skill-algorithms, cv:skill-software-engineering.

cv:edu-tuw-bsc a schema:EducationalOrganization ;
    schema:name "Technical University of Vienna" ;
    cv:degree "Bsc. Software Engineering" ;
    cv:startDate "2021-10-01"^^xsd:date ;
    cv:endDate "2024-09-01"^^xsd:date ;
    cv:status "Finsihed" ;
    cv:usedSkill cv:skill-angular, cv:skill-java, cv:skill-algorithms, cv:skill-spring-boot, cv:skill-software-engineering .

# TODO: Add more and Refine

# ─────────────────────────────────────────────
# Projects
# ─────────────────────────────────────────────

cv:proj-lidarc a cv:Project ;
    schema:name "LiDARC" ;
    schema:description "This system provides an interactive platform for uploading, processing, and comparing pointcloud sets with a focus on efficient analysis and clear visual feedback. Users can submit data through a web-based interface, trigger a comparison, and explore the resulting analyses through interactive visualizations. \n\n The system is designed to handle computationally intensive tasks in the background, allowing users to continue working without interruption while results are generated asynchronously. Created Results can be viewed and additionally downloaded as a Report." ;
    schema:url <https://github.com/BFW-Remote-Sensing/LiDARC> ;
    cv:usedSkill cv:skill-vue ;
    cv:status "Finsihed" .




 # TODO ADD More and refine
 
# ─────────────────────────────────────────────
# Languages
# ─────────────────────────────────────────────

cv:lang-german a cv:Language ;
    skos:prefLabel "German" ;
    cv:proficiency "Native" .

cv:lang-english a cv:Language ;
    skos:prefLabel "English" ;
    cv:proficiency "Fluent" .

# ─────────────────────────────────────────────
# Relationships 
# ─────────────────────────────────────────────

cv:edu-tuw cv:locatedIn cv:loc-vienna .
cv:exp-siemens cv:locatedIn cv:loc-vienna .

cv:loc-vienna a schema:Place ;
    schema:name "Vienna, Austria" .

